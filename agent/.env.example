TELEGRAM_BOT_TOKEN=            # from @BotFather
OPERATOR_TELEGRAM_ID=          # Sean's numeric Telegram user ID — message @userinfobot to get it

AGENT_MODEL=claude-sonnet-5
AGENT_EFFORT=medium
MAX_TURNS=8

CLAUDE_CODE_OAUTH_TOKEN=       # from `claude setup-token` — Max-subscription auth for the Agent SDK

AGENTMAIL_API_KEY=             # optional — enables `send` on email drafts; unset = drafting still works
AGENTMAIL_INBOX_ID=            # from the AgentMail dashboard (not necessarily the email address itself)

KV_REST_API_URL=        # optional — powers the Mini App dashboard's live status view. These
KV_REST_API_TOKEN=      # names (not UPSTASH_REDIS_REST_*) match what Vercel's native Upstash
                         # integration actually injects — copy both values from the
                         # creatorstacked Vercel project's Environment Variables page.
                         # Unset = the bot works the same, the dashboard just has no live
                         # status/spend data.
DASHBOARD_URL=https://creatorstacked.com/dashboard   # the `app` command's Mini App button

LOG_LEVEL=INFO
